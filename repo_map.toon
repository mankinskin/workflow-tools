      children[2]:
        - name: prompts
          kind: dir
          path: "agent-files/.agents/prompts"
          children[10]{name,kind,path}:
            "build-validate-tools.prompt.md",file,"agent-files/.agents/prompts/build-validate-tools.prompt.md"
            commit.prompt.md,file,"agent-files/.agents/prompts/commit.prompt.md"
            "handoff-tickets.prompt.md",file,"agent-files/.agents/prompts/handoff-tickets.prompt.md"
            handoff.prompt.md,file,"agent-files/.agents/prompts/handoff.prompt.md"
            implement.prompt.md,file,"agent-files/.agents/prompts/implement.prompt.md"
            interview.prompt.md,file,"agent-files/.agents/prompts/interview.prompt.md"
            iteration.prompt.md,file,"agent-files/.agents/prompts/iteration.prompt.md"
            research.prompt.md,file,"agent-files/.agents/prompts/research.prompt.md"
            "sync-model-prices.prompt.md",file,"agent-files/.agents/prompts/sync-model-prices.prompt.md"
            "tool-grant-regression-probe.prompt.md",file,"agent-files/.agents/prompts/tool-grant-regression-probe.prompt.md"
        - name: skills
